{
  "schema_id": "module3_uturn_v1",
  "module": "module3",
  "version": "1.0.0",
  "frozen_in": "PHASE_A",
  "task_type": "binary_uturn_detection_plus_demand_context",
  "label_policy": {
    "primary": "independent_uturn_annotation_or_validated_trajectory_events",
    "forbidden": [
      "Do not create y by thresholding turn_intensity / sum_abs_dheading / uturn_score then train on those same fields as the sole discriminative inputs without independent labels",
      "Do not reuse quarantined module3_ml_table / uturn_candidate_labels heuristic y for reported metrics",
      "Distinguish left/right turns from U-turns"
    ],
    "label_name": "y_uturn",
    "label_values": {
      "0": "NOT_UTURN",
      "1": "UTURN"
    },
    "label_sources_allowed": [
      "human_annotation",
      "independently_validated_trajectory_event"
    ]
  },
  "split_policy": {
    "method": "group",
    "group_keys": ["site_id", "vehicle_id"],
    "secondary_group_keys_video": ["video_id"],
    "forbidden": "random_row_split"
  },
  "row_grain": "one_row_per_vehicle_trajectory_segment",
  "identity_columns": [
    "sample_id",
    "video_id",
    "site_id",
    "vehicle_id",
    "track_id",
    "junction_id",
    "label_source"
  ],
  "model_input_features": [
    {
      "name": "duration_sec",
      "dtype": "float",
      "required": true
    },
    {
      "name": "mean_speed",
      "dtype": "float",
      "required": true
    },
    {
      "name": "std_speed",
      "dtype": "float",
      "required": true
    },
    {
      "name": "max_speed",
      "dtype": "float",
      "required": true
    },
    {
      "name": "path_length",
      "dtype": "float",
      "required": true
    },
    {
      "name": "displacement",
      "dtype": "float",
      "required": true
    },
    {
      "name": "tortuosity",
      "dtype": "float",
      "required": true,
      "notes": "Allowed as feature only if y is independently annotated — not if y was defined from tortuosity threshold"
    },
    {
      "name": "net_heading_change",
      "dtype": "float",
      "required": true
    },
    {
      "name": "peak_heading_change",
      "dtype": "float",
      "required": true
    },
    {
      "name": "heading_reversal_ratio",
      "dtype": "float",
      "required": true
    },
    {
      "name": "in_uturn_pocket",
      "dtype": "int",
      "required": true,
      "range": [0, 1]
    },
    {
      "name": "approach_id_start",
      "dtype": "category",
      "required": true,
      "values": ["North", "South", "East", "West", "unknown"]
    },
    {
      "name": "approach_id_end",
      "dtype": "category",
      "required": true,
      "values": ["North", "South", "East", "West", "unknown"]
    },
    {
      "name": "waiting_vehicle_count",
      "dtype": "int",
      "required": true
    },
    {
      "name": "approach_density",
      "dtype": "float",
      "required": true
    },
    {
      "name": "conflict_gap_sec_proxy",
      "dtype": "float",
      "required": false,
      "notes": "Context for Safety Shield / demand; optional in classifier"
    }
  ],
  "forbidden_training_features": [
    "y_uturn",
    "uturn_candidate",
    "label_from_heading_heuristic",
    "uturn_score_as_label"
  ],
  "notes_on_uturn_score": "Live perception may still compute uturn_score for UI/debug. For training, prefer geometry summaries with independent y. Do not set y = 1{uturn_score > t} and then train primarily on uturn_score.",
  "sequence_optional": {
    "enabled_for_dl": true,
    "timesteps": 64,
    "channels": [
      "x_norm",
      "y_norm",
      "speed",
      "heading_sin",
      "heading_cos"
    ]
  },
  "inference_compatibility": {
    "perception_engine": "yolov8n_bytetrack",
    "builder": "feature_builder.build_module3_features",
    "schema_hash_file": "models/module3/schema_hash.txt"
  }
}
